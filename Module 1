class Node:
    def __init__(self, c, p):
        self.c = c
        self.p = p
        self.next = None

def add_poly(a, b):
    result = []
    while a and b:
        if a.p == b.p:
            result.append((a.c + b.c, a.p))
            a, b = a.next, b.next
        elif a.p > b.p:
            result.append((a.c, a.p))
            a = a.next
        else:
            result.append((b.c, b.p))
            b = b.next
    return result

a = Node(3, 2)
a.next = Node(2, 1)
a.next.next = Node(1, 0)

b = Node(4, 2)
b.next = Node(5, 0)

print("Sum:", add_poly(a, b))
