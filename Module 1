class Node:   
def __init__(self, c, p): self.c = c 
self.p = p self.next = None
def add_term(head, c, p):     new = Node(c, p) 
if head is None:         return new     cur = head     while cur.next:         
cur = cur.next     cur.next = new     return head
def add_poly(a, b):     result = None     while a and b:        
if a.p == b.p:
   result = add_term(result, a.c + b.c, a.p)             a, b = a.next, b.next       
elif a.p > b.p:result = add_term(result, a.c, a.p) a = a.next    
else:
     result = add_term(result, b.c, b.p) b = b.next     
while a:
        result = add_term(result, a.c, a.p) a = a.next 
while b:
        result = add_term(result, b.c, b.p) b = b.next
return result
